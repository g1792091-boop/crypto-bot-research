 // 폴더를 탐색기로 연다
 func openDir(dir string) { exec.Command("explorer", dir).Start() }
+
+// 윈도우의 실제 '문서' 폴더 (OneDrive 로 옮겨진 경우 포함) — FOLDERID_Documents
+func documentsDir() string {
+	guid := [16]byte{0xD0, 0x9A, 0xD3, 0xFD, 0x8F, 0x23, 0xAF, 0x46, 0xAD, 0xB4, 0x6C, 0x85, 0x48, 0x03, 0x69, 0xC7}
+	shell32 := syscall.NewLazyDLL("shell32.dll")
+	proc := shell32.NewProc("SHGetKnownFolderPath")
+	if proc.Find() != nil {
+		return ""
+	}
+	var p *uint16
+	hr, _, _ := proc.Call(uintptr(unsafe.Pointer(&guid[0])), 0, 0, uintptr(unsafe.Pointer(&p)))
+	if hr != 0 || p == nil {
+		return ""
+	}
+	defer syscall.NewLazyDLL("ole32.dll").NewProc("CoTaskMemFree").Call(uintptr(unsafe.Pointer(p)))
+	n := 0
+	for ptr := unsafe.Pointer(p); *(*uint16)(ptr) != 0; n++ {
+		ptr = unsafe.Add(ptr, 2)
+	}
+	return syscall.UTF16ToString(unsafe.Slice(p, n))
+}
