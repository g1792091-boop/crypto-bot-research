# '레인지 봇' 페이퍼 봇 (owners 10/26 "그 구조로 가자", "진행해줘", docs/range-bot-ko.md): 레인지 필터 3중 일치 1시간
# (후보 리그 커스텀값 80·9.0), 코인·BTC 1시간 슈퍼트렌드 확인, 0.2 ATR 되돌림 1시간 기다려 다음 5분봉 시가에 시장가,
# 한 신호씩, 고정 익절 순ROE +10%, 손절 순ROE -50%, 증거금 40% x BTC 40배 / 알트 30배 (deploy/combo.range.json).
# The same program, user and sandbox as paperbot-combo.service, its own config /etc/paperbot/combo-range.json and its own
# database /var/lib/paperbot/combo/range.db (account COMBO@mix in that file). The WOO X Pro executor
# (paperbot-executor-mexc) follows it once its config says "paper_db": "/var/lib/paperbot/combo/range.db"
# (deploy/range_switch.py, while WOO X Pro holds no position). Paper only: no orders. Its signals are computed here from
# 5m bars built from paper3.db's 1m bars (history from Binance's public klines at start, about 125 days of 5m bars).
#
# install.sh installs this unit but never enables or starts it. A person starts it after writing
# /etc/paperbot/combo-range.json (docs/range-bot-ko.md):
#   sudo systemctl enable --now paperbot-combo-range
# Telegram: its start and error lines and its own entry / exit lines ("[합친 봇 페이퍼 레인지 봇] ...") go to the owners'
# chats. Restart is safe: the account, the pullback wait and the last minute are in its database; missed minutes are
# replayed from paper3.db, missed signals are recorded late and never traded.
[Unit]
Description=paperbot combined bot '레인지 봇' (F7_RF_TRIPLE 1h custom 80/9.0, its own config combo-range.json; no orders)
After=network-online.target paperbot-live3.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/live.env
# the live bot's token and the owners' private chats (optional, deploy/live-telegram.env.example)
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.combo run --config /etc/paperbot/combo-range.json
Restart=always
RestartSec=15
NotifyAccess=main
WatchdogSec=600
TimeoutStartSec=20min
TimeoutStopSec=60
Nice=5
MemoryMax=1500M
# a live executor follows this paper bot: in a server-wide memory shortage experiments go first (owners 2026-10-19)
OOMScoreAdjust=-500
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/paperbot/combo
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env -/etc/paperbot/debate.env -/var/lib/paperbot/exec -/var/lib/paperbot/debate -/var/lib/paperbot/.claude -/var/lib/paperbot/.claude.json -/var/lib/paperbot/.local -/var/backups/paperbot

[Install]
WantedBy=multi-user.target
