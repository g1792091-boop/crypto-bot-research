# The Toobit order executor (owners 10-25, docs/toobit-ko.md: a new $50 live bot on Toobit that will follow the rule
# bot's V3.9 1-hour paper account; its exits are decided separately): the same program, sandbox and user as
# paperbot-executor.service, its own config /etc/paperbot/executor-toobit.json ("exchange": "toobit", made by the owners
# from deploy/executor.live-toobit.json once the paper account is chosen; install.sh never writes it) and its own
# database /var/lib/paperbot/exec/executor-toobit-live.db. Mainnet only (Toobit has no futures testnet).
#
# Its keys are in its OWN root-only key file /etc/paperbot/executor-toobit.env (deploy/executor-toobit.env.example),
# loaded INSTEAD of /etc/paperbot/executor.env: the other executors and this one never see each other's keys
# ("own_keys": true in its config refuses a start with another exchange's key in that file). Everything else of the header
# of paperbot-executor.service applies unchanged: own user paperbot-exec, exit 2 = a gate refused (not restarted),
# SIGTERM lets the loop in progress finish.
#
# install.sh installs this unit but NEVER enables or starts it. A person starts it, after the key, the drill (long and
# short both [OK]) and the config:
#   sudo systemctl start paperbot-executor-toobit    (and `enable` only after the first days went as expected)
[Unit]
Description=paperbot order executor (Toobit; mainnet: every gate must pass)
After=network-online.target paperbot-live3.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=paperbot-exec
Group=paperbot
UMask=0027
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/executor-toobit.env
# the live bot's token and the owners' private chats (optional, deploy/live-telegram.env.example)
EnvironmentFile=-/etc/paperbot/live-telegram.env
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.executor run --config /etc/paperbot/executor-toobit.json
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
TimeoutStopSec=60
# Real money first (owners 2026-10-19: the live bots share the server with the experiments): in a server-wide
# memory shortage the kernel kills experiments long before the executors (the shadows have +500).
OOMScoreAdjust=-900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/paperbot/exec
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env
# no core dump (it would hold the keys)
LimitCORE=0

[Install]
WantedBy=multi-user.target
