# /etc/candleague/candleague.env  (root:candleague 640) — 후보 리그 설정 / candidate league settings.
# 서버에서만, 편집기 안에서만 채웁니다:  SUDO_EDITOR=nano sudoedit /etc/candleague/candleague.env
# 진짜 값은 채팅·메일·저장소에 절대 넣지 않습니다. 이 예시 파일에는 값이 없습니다.
# The install script copies this file to /etc/candleague/candleague.env only when that file does not exist yet.

# ---- 텔레그램 / Telegram (데모 랩 봇의 토큰을 그대로 써도 됩니다: 메시지 앞에 [후보 리그]가 붙습니다)
CANDLEAGUE_TG_TOKEN=
# 받을 번호, 쉼표로 이어 최대 4개 / 1-4 chat ids, comma separated
CANDLEAGUE_TG_CHAT=

# ---- 대시보드 / dashboard
# 비밀번호 해시 만들기 / make it:  cd /opt/candleague/app && /opt/candleague/venv/bin/python -B -m candleague.dash hash
# 해시에 $ 기호가 있으니 작은따옴표로 감쌉니다 / wrap it in single quotes: CANDLEAGUE_DASH_PASSWORD_HASH='pbkdf2$...'
CANDLEAGUE_DASH_PASSWORD_HASH=
# 아무 글자 32자 이상 / any 32+ characters:  openssl rand -hex 32
CANDLEAGUE_DASH_SECRET=
# 대시보드 주소: 서버의 Tailscale 주소(규칙봇 대시보드와 같은 주소) / the server's Tailscale address
CANDLEAGUE_DASH_HOST=
CANDLEAGUE_DASH_PORT=8091

# ---- 딥시크 금액 보이기 (두 분 규칙: 기본은 숨김) / show DeepSeek money (owners' rule: hidden)
CANDLEAGUE_DS_MONEY=0
