# Paper v3 dashboard. Reads paper3.db, daily3.db and agents3.db read-only; its only write is inbox.db
# (owner posts in the agent rooms and approve/reject clicks). Listens on DASH_HOST (127.0.0.1 or the
# Tailscale address); reach it through Tailscale or an SSH tunnel.
[Unit]
Description=paperbot v3 dashboard
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=paperbot
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/dash.env
# After a reboot the Tailscale address can appear a few seconds after the network: wait up to 60 s for
# DASH_HOST so the first start does not fail to bind (Restart=always would retry anyway).
ExecStartPre=-/bin/sh -c 'n=0; until ip -4 -o addr show | grep -qF " inet $$DASH_HOST/" || [ $$n -ge 60 ]; do n=$$((n+1)); sleep 1; done'
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.dash --db /var/lib/paperbot/paper3.db --daily-db /var/lib/paperbot/daily3.db --agents-db /var/lib/paperbot/agents3.db --inbox-db /var/lib/paperbot/inbox.db --host ${DASH_HOST} --port 8080
Restart=always
RestartSec=5
# The dashboard is a writer (inbox.db) and faces the network: it may write only /var/lib/paperbot
# (inbox.db, and the -shm files its read-only connections need), cannot replace the Claude Code
# program the agents run (~/.local) or the 5-year caches, and cannot read the exchange key or the
# agents' login token. No database FILE is listed read-only here: this service runs for weeks, and a
# listed file stays pinned to its old inode after a restore (old file + new WAL); the code opens
# paper3.db, daily3.db and agents3.db read-only (file:...?mode=ro) instead.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/paperbot
ReadOnlyPaths=-/var/lib/paperbot/.local -/var/lib/paperbot/lab
# The order executor's keys and its databases (directory: a stable inode) are never visible here.
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/live.env -/etc/paperbot/executor.env -/var/lib/paperbot/exec -/var/backups/paperbot

[Install]
WantedBy=multi-user.target
