# Paper v3 dashboard, read-only. Listens on 127.0.0.1 only; reach it through Tailscale or an SSH tunnel.
[Unit]
Description=paperbot v3 dashboard
After=network-online.target

[Service]
Type=simple
User=paperbot
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/dash.env
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.dash --db /var/lib/paperbot/paper3.db --host ${DASH_HOST} --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
