# /etc/paperbot/dash.env  (owner paperbot, chmod 600). Never commit the real file.
# Make the hash on the server:  /opt/paperbot/venv/bin/python -m paperbot.dash hash
DASH_PASSWORD_HASH=
# 32+ random characters:  openssl rand -hex 32
DASH_SECRET=
# 127.0.0.1 with an SSH tunnel, or the server's Tailscale address (100.x.y.z)
DASH_HOST=127.0.0.1
# Optional: names a post or an approve/reject in the agent rooms may be signed with, comma separated
# (e.g. two owners' first names). Any other name is not stored.
#DASH_OWNERS=
