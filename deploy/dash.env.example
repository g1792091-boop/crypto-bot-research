# /etc/paperbot/dash.env  (owner paperbot, chmod 600). Never commit the real file.
# Make the hash on the server:  /opt/paperbot/venv/bin/python -m paperbot.dash hash
DASH_PASSWORD_HASH=
# 32+ random characters:  openssl rand -hex 32
DASH_SECRET=
# 127.0.0.1 with an SSH tunnel, or the server's Tailscale address (100.x.y.z)
DASH_HOST=127.0.0.1
# Optional: names a post or an approve/reject in the agent rooms may be signed with, comma separated
# (e.g. two owners' first names). Any other name is not stored.
#DASH_OWNERS=
# 실거래 screen (#/livebots, dash/more/livebots.py): where the live bots' records are read (read-only). The defaults are
# the 10/19 start guide's paths; set a line only when a file lives elsewhere. The executor configs carry no keys (the
# keys are in executor.env, which the dashboard never opens).
#PAPERBOT_LIVE_PAPER_DB=/var/lib/paperbot/combo/live-ac.db
# the second paper bot ('VWAP 개선판', docs/vwap-bot-ko.md; before 10-23 규칙봇 15 at -35 %, live15-mexc.db): shown next
# to the first once its file exists or once an executor follows it
#PAPERBOT_LIVE_PAPER2_DB=/var/lib/paperbot/combo/vwap.db
#PAPERBOT_LIVE_BYBIT_DB=/var/lib/paperbot/exec/executor-bybit-live.db
#PAPERBOT_LIVE_MEXC_DB=/var/lib/paperbot/exec/executor-mexc-live.db
#PAPERBOT_LIVE_BYBIT_CONFIG=/etc/paperbot/executor.json
#PAPERBOT_LIVE_MEXC_CONFIG=/etc/paperbot/executor-mexc.json
# the third executor (딥코인, owners 10-24, docs/deepcoin-ko.md: it follows the 'VWAP 개선판'): on the site only once its
# config file or its database is there (until then every page shows the two executors as before)
#PAPERBOT_LIVE_DEEPCOIN_DB=/var/lib/paperbot/exec/executor-deepcoin-live.db
#PAPERBOT_LIVE_DEEPCOIN_CONFIG=/etc/paperbot/executor-deepcoin.json
# the fourth executor (WOO X Pro 2, owners 10-24, docs/friend-bot-ko.md: a second WOO X Pro account following '친구 매매법')
# the same way, named by its config's label; its paper bot's file is never an account of its own on the site
#PAPERBOT_LIVE_WOOXPRO2_DB=/var/lib/paperbot/exec/executor-wooxpro2-live.db
#PAPERBOT_LIVE_WOOXPRO2_CONFIG=/etc/paperbot/executor-wooxpro2.json
#PAPERBOT_LIVE_PAPER3_DB=/var/lib/paperbot/combo/friend.db
# the fifth executor (투비트, owners 10-25, docs/toobit-ko.md: a $50 executor; the paper account it follows is decided
# later) the same way, named by its exchange; the paper it follows is never an account of its own on the site
#PAPERBOT_LIVE_TOOBIT_DB=/var/lib/paperbot/exec/executor-toobit-live.db
#PAPERBOT_LIVE_TOOBIT_CONFIG=/etc/paperbot/executor-toobit.json
# the 레인지 봇 (owners 10-26, docs/range-bot-ko.md: WOO X Pro follows it): its own paper account on the site (봇별 › 레인지
# 봇) once an executor follows it or its file is there, told by the ``range`` section of its config
#PAPERBOT_LIVE_RANGE_DB=/var/lib/paperbot/combo/range.db
# 설정 · 거래 tabs: the combined bot's config, read only before the bot wrote its own start record into its database
#PAPERBOT_LIVE_COMBO_CONFIG=/etc/paperbot/combo.json
#PAPERBOT_LIVE_COMBO2_CONFIG=/etc/paperbot/combo-vwap.json
#PAPERBOT_LIVE_RANGE_CONFIG=/etc/paperbot/combo-range.json
# 그림자 tab: the folder of shadow-b.db, shadow-nocut.db and shadow-ac32.db
#PAPERBOT_LIVE_SHADOW_DIR=/var/lib/paperbot/combo
# 거래 · 안전 tabs: the live checks' file (paperbot/livecheck.py: loss cards, morning checks, the watcher's alarms)
#PAPERBOT_LIVE_CHECK_DB=/var/lib/paperbot/livecheck.db
# 성적 tab: the improvement ledger and weekly scorecards (paperbot/liveimprove.py)
#PAPERBOT_LIVE_IMPROVE_DB=/var/lib/paperbot/liveimprove.db
# 관제 · 신호 tabs, 진입 대기: the rule bot's 1m bars (the level a break signal waits for is the signal bar's high / low)
#PAPERBOT_LIVE_RULE_DB=/var/lib/paperbot/paper3.db
