# 믹스 30분 봇 손실 카드 (paperbot/mixcheck.py pass, docs/mixchop-ko.md 8장): every 5 minutes, each closed live trade of
# the '믹스 30분 봇' once, a few minutes after its close: a losing one gets a loss card (the plan: one stop-out = 0.25 %
# of the equity plus the fees; normal stop-out as designed, or abnormal with the causes the bot's log and the numbers
# show; the paper twin's result on the same signal), a winning one a short line; the abnormal ones as WARN, the rest
# quiet. Each pass also notes the bot's last handled 30m close (the morning's signal replay reads it). Read-only
# towards the bot (its files read as group paperbot, never written; no exchange account, no key, no order; no Binance
# call). Writes only /var/lib/paperbot/mixcheck/state.json. One pass takes about a second.
# By hand (prints what would be sent; sends nothing, writes nothing):
#   cd /opt/crypto-bot-research && sudo -u paperbot /opt/paperbot/venv/bin/python -m paperbot.mixcheck pass --dry-run
[Unit]
Description=paperbot 믹스 30분 봇 손실 카드 every 5 minutes (read-only, no orders)
After=network-online.target
Wants=network-online.target
OnFailure=paperbot-failed@%n.service

[Service]
Type=oneshot
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.mixcheck pass
Nice=5
MemoryMax=400M
TimeoutStartSec=3min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/paperbot/mixcheck
ReadOnlyPaths=-/var/lib/paperbot/exec -/var/lib/paperbot/mixchop-paper /opt/crypto-bot-research
InaccessiblePaths=-/etc/paperbot/executor-wooxpro2.env -/etc/paperbot/executor-toobit.env -/etc/paperbot/executor.env -/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/debate.env -/etc/paperbot/live.env -/etc/paperbot/live-telegram.env -/var/lib/paperbot/debate -/var/lib/paperbot/.claude -/var/lib/paperbot/.claude.json -/var/lib/paperbot/.local -/var/backups/paperbot
