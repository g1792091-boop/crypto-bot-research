# '바이비트 봇' (owners 2026-10-29, docs/mixbybit-ko.md): the Bybit sub-account trades the friend's two rules by itself
# (python -m paperbot.mixchop with deploy/mixbybit.live.json, no paper bot in between): Binance's closed 30m bars -> the
# friend's trend (four votes) and its OBV light -> dark turn / Stoch RSI ● at each 30m close -> a market order + a
# resting stop (ATR14 x 3) on Bybit, the net-ROE ladder (10 -> 8, then every 5 %) followed on 1m bars. One position at a
# time, BTC · ETH · SOL · DOGE · LTC · BCH (40x) · ZEC (20x), margin 40 % of the balance.
#
# Keys: BYBIT_LIVE_API_KEY / BYBIT_LIVE_API_SECRET and PAPERBOT_LIVE_MAINNET in the root-only /etc/paperbot/executor.env
# (the file the old Bybit executor read; nothing new to type). That executor (paperbot-executor, following the 추세판단
# 봇) must not trade the same account at the same time: Conflicts= below stops it when this one starts. Own user
# paperbot-exec, the executors' sandbox; exit 2 = a gate refused (not restarted).
#
# install.sh installs this unit but NEVER enables or starts it. A person starts it after the guide's checks:
#   sudo systemctl start paperbot-mixbybit      (enable only after the first days went as expected)
[Unit]
Description=paperbot '바이비트 봇' (Bybit, mainnet: real orders)
After=network-online.target
Wants=network-online.target
Conflicts=paperbot-executor.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=paperbot-exec
Group=paperbot
UMask=0027
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/executor.env
# the live bot's token and the owners' private chats (optional, deploy/live-telegram.env.example)
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.mixchop run --config /etc/paperbot/mixbybit.json
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
TimeoutStopSec=60
OOMScoreAdjust=-900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/paperbot/exec
# systemd reads executor.env before the sandbox: the process itself never needs the file (the keys come in its environment)
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env -/etc/paperbot/executor-wooxpro2.env -/etc/paperbot/executor-toobit.env -/etc/paperbot/executor-gate.env
LimitCORE=0

[Install]
WantedBy=multi-user.target
