# '게이트 봇' (owners 2026-10-31, docs/gate-bot-ko.md): no trading rule. A friend enters by hand on their own Gate
# account (USDT perpetuals, one-way mode); this program (python -m paperbot.gateguard) puts the stop on each position
# (entry -/+ Gate's 15m ATR(14) x 3, pulled inside the liquidation price when beyond it) and moves it up the net-ROE
# ladder (10 -> 8, then every 2 %). It places only its own stops (and a market close when a lock was already passed);
# the friend's own orders are never touched. Its stops rest on Gate and keep protecting while this unit is off.
#
# Keys: GATE_LIVE_KEY / GATE_LIVE_SECRET, GATE_LIVE_KEY_CHECKED and PAPERBOT_LIVE_MAINNET in the root-only
# /etc/paperbot/executor-gate.env (deploy/executor-gate.env.example), which only this unit loads. Own user
# paperbot-exec, the executors' sandbox; exit 2 = a start gate refused (not restarted).
#
# install.sh installs this unit but NEVER enables or starts it. A person starts it after the guide's checks:
#   sudo systemctl start paperbot-gateguard      (enable only after the first positions went as expected)
[Unit]
Description=paperbot '게이트 봇' (Gate, mainnet: stops on the friend's positions)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=paperbot-exec
Group=paperbot
UMask=0027
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/executor-gate.env
# the live bot's token and the owners' private chats (optional, deploy/live-telegram.env.example)
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.gateguard run --config /etc/paperbot/gateguard.json
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
TimeoutStopSec=60
OOMScoreAdjust=-900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/paperbot/exec
# systemd reads executor-gate.env before the sandbox: the process itself never needs the file (the keys come in its
# environment), and never sees the other exchanges' key files
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env -/etc/paperbot/executor-wooxpro2.env -/etc/paperbot/executor-toobit.env -/etc/paperbot/executor-gate.env
LimitCORE=0

[Install]
WantedBy=multi-user.target
