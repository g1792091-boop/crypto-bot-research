# /etc/paperbot/agents.env  (owner paperbot, chmod 600). Never commit the real file.
# Subscription login for Claude Code: run `claude setup-token` once and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# Do NOT add ANTHROPIC_API_KEY here: in print mode Claude Code would use it
# and bill the API separately. The runner strips it anyway.
# Keep "extra usage" (pay-as-you-go overage) turned OFF on the owners' Claude account: with it on,
# calls past the plan's limit are billed per use and nothing in print mode lets the runner refuse them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_CRITICAL=
TELEGRAM_CHAT_WARN=
TELEGRAM_CHAT_INFO=

# ---------------------------------------------------------------------------------------------
# Agent rooms (paperbot-agents.timer -> python -m paperbot.agents.rooms tick; docs/agent-rooms.md)
# Everything below is optional. A commented line means the default shown on it (removing its '#' changes nothing):
# to turn a setting on, write NAME=VALUE without '#' and with the value its comment gives, alone on its line (no
# comment after the value). install.sh never rewrites the server's /etc/paperbot/agents.env, so a line added here
# later is missing there: add it at the end (sudoedit). A bad value stops
# the tick with an error in `systemctl status paperbot-agents` (it never runs without a limit you set).
# None of these can loosen the code gate: they only set AI budgets, copy slots and owner confirmation.
#
# AI budget per kind of meeting, per Korea-time day: CLASS=CALLS[:TOKENS], comma separated.
#   incident  = 사고 점검 (강제청산, 밤 점검 불일치, 데이터 끊김)
#   owner     = 두 분이 방에 남긴 글에 답하는 회의
#   loss      = 손실 묶음·파산 복기 (매매법 방; 8번과 그만큼의 토큰은 파산 복기용으로 남겨 둠)
#   (incident 중 5번과 그만큼의 토큰은 강제청산 같은 긴급 알림용으로 남겨 둠)
#   scheduled = 아침 08:00, 순위 검토 14:00, 낙관·비관 토론 12:00, 저녁 22:00, 30일 점검
#   weekly    = 매매법 방 주간 검토, 봉 비교 18:00, 요일별 분석 회의 11:00(월·화·수·토), 경제지표 복기 11:00
#   total     = 하루 전체 합계. 사고·정기 회의의 남은 몫은 그 회의들을 위해 비워 둠
#   week      = 최근 7일(한국 시간) 전체 합계. 여기서도 사고·정기 회의의 오늘 남은 몫과 앞으로 6일 몫은 비워 둠
# Every call counts against the owners' own Claude plan (shared with their chats). With the code defaults a
# busy day is about 90-110 calls and up to 3.4 million tokens (30-50k tokens per call, Claude Code's own cached
# prompt included; the token caps bind before the call caps), about 85 calls a day over a busy week (17 million). Opus calls use the
# plan faster than sonnet calls, but the caps count both the same.
# Settings that leave a kind of meeting no calls at all (e.g. loss=8, total no bigger than
# incident + scheduled, or week no bigger than 7 x (incident + scheduled)) are allowed but printed
# as a warning at every pass (journalctl -u paperbot-agents).
# On a small plan (e.g. Pro) start lower, e.g. AGENTS_BUDGET=total=60,week=300, and raise it on purpose.
# At a limit a meeting that already started stops with
# '오늘 AI 사용 한도에 도달해 다음으로 미룹니다' and runs the next day; one that cannot start waits.
# The code's defaults (a conservative start):
#AGENTS_BUDGET=incident=15:400000,owner=20:500000,loss=48:1400000,scheduled=20:600000,weekly=20:550000,total=120:3400000,week=600:17000000
# The owners' choice (2026-10-01, Claude Max plan: use it fully; raised 2026-10-03 when loss reviews stopped at 20:00
# on the loss tokens with the plan's weekly use at 7%: one call counts Claude Code's own cached prompt too, about
# 30-50k tokens). When the plan's own limit is reached anyway, the rooms pause by themselves and carry on later;
# lower these if the owners' own Claude chats start hitting the limit. Set again 2026-10-04 for the restarted run
# (review 3c A-1, simulated 10 days with the real rooms.tick): 150 calls / 6M tokens a day, 700 / 28M in 7 days,
# loss reviews 40 calls / 2M tokens (their tokens bind at 30-50k per call), research 16 calls / 0.5M with the lab
# every 180 minutes (below), so the 18:00 timeframe-split meeting still finds room every evening.
AGENTS_BUDGET=incident=30:1000000,owner=40:1400000,loss=40:2000000,scheduled=30:1200000,weekly=40:1600000,research=16:500000,total=150:6000000,week=700:28000000
#
# Approved copy proposals wait for the owners' OK in the dashboard:
#   auto = for the first AGENTS_OWNER_OK_DAYS days of the run, yes = always
#   (no is refused: the live runner never starts a copy decided in the first 60 days without the owners' click)
#AGENTS_OWNER_OK=auto
#AGENTS_OWNER_OK_DAYS=60
#
# Observation period at the start: the staff record, analyse and run 5-year tests, but make no copy
# proposal until AGENTS_OBSERVE_DAYS days after the bot's first start (default 21, never lower: the live runner
# refuses for good a proposal written earlier), or through the KST date AGENTS_OBSERVE_UNTIL (e.g. 2026-10-21;
# empty = none) when that is later.
# The agents also wait for the live runner's own floor (its extras.json observe_days / observe_until)
#AGENTS_OBSERVE_DAYS=21
#AGENTS_OBSERVE_UNTIL=
#
# Copy-proposal slots (proposals waiting for the owners or approved): per strategy and in total
#AGENTS_COPY_CAP_PER_STRATEGY=1
#AGENTS_COPY_CAP_TOTAL=10
#
# Telegram messages the staff may send by themselves per day (the 22:00 summary is not counted)
#AGENTS_FLAG_MAX_PER_DAY=3
#
# Meetings per 15-minute pass, and per room per day (incident meetings are not counted per room;
# one of a room's daily meetings is kept for the owners' posts)
#AGENTS_MAX_ROUNDS_PER_TICK=4
#AGENTS_MAX_ROUNDS_PER_ROOM_DAY=4
# loss-review meetings of a strategy room (owners' choice 2026-10-03; before: 3 losses, 240 minutes):
#AGENTS_LOSS_MIN_COUNT=2
#AGENTS_LOSS_MIN_GAP_MIN=120
#
# AI calls per 15-minute pass: a new meeting starts only if it fits (a strategy meeting counted at 6 calls,
# a team meeting at its number of turns), and retries of unreadable answers stop at this cap (the first
# meeting of a pass and incident meetings are exempt)
#AGENTS_MAX_CALLS_PER_TICK=12
#
# New-strategy lab (team:lab, '새 매매법 연구실'): a lab meeting may start every this many minutes (0 = no lab
# meetings). Each meeting makes at most 3 AI calls and runs at most 3 five-year tests (code). It uses
# only spare capacity: its own 'research' cap above, paced over the day, and it leaves the reviews' share.
# The code's default is 60; the owners' budget above is sized for 180 (2026-10-04).
AGENTS_RESEARCH_EVERY_MIN=180
# 손익 복기팀 순위 검토(잔고 상위·하위 3개 매매법) 시각, 한국 시간 0~23. off = 열지 않음
#AGENTS_RANKING_HOUR=14
# 봉 비교 회의(봉마다 성적이 갈린 매매법 방) 시각, 한국 시간 0~23. off = 열지 않음
#AGENTS_TF_SPLIT_HOUR=18
# 일요일 주간 성적표 텔레그램(코드 계산, AI 없음) 시각, 한국 시간 0~23. off = 보내지 않음
#AGENTS_WEEKLY_REPORT_HOUR=21
# 요일별 분석 회의(한국 시간 0~23, off = 열지 않음). 정해진 요일 11:00에 한 번, 지난 회의 뒤 새 거래가 많이
# 쌓인 주에는 다른 날 11:00에 한 번 더(주 2번까지). 지난 7일 매매법 계좌의 끝난 거래가 AGENTS_ANALYSIS_MIN_TRADES건
# 이상이고 실험 시작 뒤 7일이 지나야 엽니다. 추가 회의는 지난 회의 뒤 새 거래가 그 AGENTS_ANALYSIS_EXTRA_FACTOR배 이상이고
# 2일 이상 지났을 때만.
#   월 비용·체결 회의(운영·검증팀), 화 조합·동시 손실 회의(리스크팀), 수 코인·장세 회의(손익 복기팀),
#   목 손익비·청산 회의(손익 복기팀: 손익비·본전 승률·청산 이유·그림자, AI 4번),
#   금 낙폭·파산 위험 회의(리스크팀: 낙폭·몬테카를로 파산 확률·크기(설명용)·실전 대 5년 백테스트, AI 3번), 토 학습 정리 회의(총괄)
#AGENTS_COST_REVIEW_HOUR=11
#AGENTS_COMBO_REVIEW_HOUR=11
#AGENTS_COIN_REVIEW_HOUR=11
#AGENTS_RR_REVIEW_HOUR=11
#AGENTS_RISK_REVIEW_HOUR=11
#AGENTS_LEARNING_REVIEW_HOUR=11
#AGENTS_ANALYSIS_MIN_TRADES=200
#AGENTS_ANALYSIS_EXTRA_FACTOR=2
# 경제지표 복기 회의(시장분석팀): data/macro_events.csv의 발표(CPI·FOMC·고용·PCE) 다음 날 이 시각, 발표마다 한 번
#AGENTS_EVENT_REVIEW_HOUR=11
# 낙관·비관 토론(시장분석팀): 매일 이 시각, 코인 하나씩 돌아가며. 판정은 기록·채점만(거래 없음)
#AGENTS_BULL_BEAR_HOUR=12
# 1 = opus를 쓰는 역할(전략가·리스크 책임자·검증관 등)도 모두 sonnet으로 회의(opus 한도가 빠듯할 때). 0 또는 비움 = 명단대로
#AGENTS_FORCE_SONNET=0
# 시험 대기열(코드만, AI 없음, docs/agent-rooms.md '시험 대기열'): 24시간 토론방이 하루에 고른 아이디어와 두 분의 시험 요청을
# 진짜 5년 시험(가설 장부에 남고 시험 수에 셈)으로 돌리는 한국 시간 하루 몫. 0 또는 비움 = 끔(기본: 대기열이 아무것도 안 함).
# 시험이 하나 늘 때마다 모든 시험의 통과 기준이 조금 엄격해지므로 토론방 몫은 하루 2개까지만 됩니다(3 이상이면 시작하지 않음).
# 켤 때 권장: AGENTS_LAB_INTAKE_DEBATE_PER_DAY=2 (두 분 10/06: 토론방 아이디어는 하루 2개까지. debate.env의
# DEBATE_LAB_PER_DAY와 같은 수로), 두 분 시험 요청은 AGENTS_LAB_INTAKE_OWNER_PER_DAY=3 (아래 '두 분 시험 요청')
#AGENTS_LAB_INTAKE_DEBATE_PER_DAY=0
#AGENTS_LAB_INTAKE_OWNER_PER_DAY=0
# 토론방의 debate.db(읽기만). 비우면 agents3.db 옆의 debate/debate.db (서버: /var/lib/paperbot/debate/debate.db)
#AGENTS_DEBATE_DB=
# 편 가르기와 누가 맞았나(docs/agent-rooms.md): 1 = 매매법 방에 편드는 직원·공격하는 직원, 반대에는 가릴 시험이 붙고
# 코드가 채점(여섯 분석 회의의 팀장 다툼 포함). 0 또는 비움 = 예전 회의(코드 기본값). 켤 때(서버 권장): AGENTS_SIDES=1
#AGENTS_SIDES=0
# 다툼 5년 시험(공용 시험 대기열이 지킴): 하루 몫(3까지)과 한 매매법 방에서 다음 다툼 시험까지 최소 일수
#AGENTS_DISPUTE_TESTS_PER_DAY=3
#AGENTS_DISPUTE_ROOM_GAP_DAYS=7
# 1 = 편 가르기 회의에도 코드가 고른 전문가 차례(AI 1번 더). 0 또는 비움 = 없음(권장)
#AGENTS_DISPUTE_EXPERT=0
# 두 분 시험 요청(docs/agent-rooms.md '두 분 시험 요청'): 위 AGENTS_LAB_INTAKE_OWNER_PER_DAY가 1 이상일 때만 켜집니다.
# 대시보드 새 매매법 연구실의 '🧪 이 매매법 시험해줘' 양식 → 연구원이 문법으로 옮김(두 분 글 회의와 같은 AI 2번) → 정확히
# 옮긴 것은 코드가 하루 몫 안에서 5년 시험, 근사로 옮긴 것은 대시보드에서 두 분이 [시험하기]를 눌러야 시험, 옮길 수 없는 것은
# 시험 안 함(시험 수에도 안 넣음). 하루 몫은 3까지(4 이상이면 시작하지 않음). 0 또는 비움 = 끔(코드 기본값). 켤 때 권장: 3
# 목표 진척도 한 줄: 1 = 22:00 저녁 텔레그램에 코드가 쓴 한 줄(오늘 5년 시험 수와 통과, 동전보다 나은 새 매매법 후보와 운만으로
# 나올 수, 판정 D-day). 0 또는 비움 = 저녁 텔레그램 그대로(코드 기본값). 대시보드 홈의 같은 한 줄은 늘 보입니다.
# 켤 때: AGENTS_GOAL_LINE=1
#AGENTS_GOAL_LINE=0
# 그림자 리그(docs/shadow-league.md): 5년 시험에서 실패한 아이디어를 같은 규칙 그대로 실제 봉에서 '가상 거래'로만 지켜봅니다.
# 모의 계좌가 아니고 331개 계좌·30일 판정·다중 검정 보정과 아무 상관이 없습니다(참고용, 판정 아님). 첫 멤버는 릴스 '매물대
# 지지→저항 전환'. 1 = 켬(15분마다 최대 20초, 바이낸스 공개 시세만 읽고 shadow_league.db에만 기록). 0 또는 비움 = 끔
# (기본: 파일도 만들지 않고 아무것도 읽지 않습니다). 켤 때: 아래 줄 맨 앞의 #을 지우고 값을 1로 바꾸면 다음 15분 차례(에이전트 실행)부터 켜집니다.
#AGENTS_SHADOW_LEAGUE=0
