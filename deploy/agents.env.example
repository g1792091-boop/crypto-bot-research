# /etc/paperbot/agents.env  (owner paperbot, chmod 600). Never commit the real file.
# Subscription login for Claude Code: run `claude setup-token` once and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# Do NOT add ANTHROPIC_API_KEY here: in print mode Claude Code would use it
# and bill the API separately. The runner strips it anyway.
# Keep "extra usage" (pay-as-you-go overage) turned OFF on the owners' Claude account: with it on,
# calls past the plan's limit are billed per use and nothing in print mode lets the runner refuse them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_CRITICAL=
TELEGRAM_CHAT_WARN=
TELEGRAM_CHAT_INFO=

# ---------------------------------------------------------------------------------------------
# Agent rooms (paperbot-agents.timer -> python -m paperbot.agents.rooms tick; docs/agent-rooms.md)
# Everything below is optional. A commented line means the default shown on it. A bad value stops
# the tick with an error in `systemctl status paperbot-agents` (it never runs without a limit you set).
# None of these can loosen the code gate: they only set AI budgets, copy slots and owner confirmation.
#
# AI budget per kind of meeting, per Korea-time day: CLASS=CALLS[:TOKENS], comma separated.
#   incident  = 사고 점검 (강제청산, 밤 점검 불일치, 데이터 끊김)
#   owner     = 두 분이 방에 남긴 글에 답하는 회의
#   loss      = 손실 묶음·파산 복기 (매매법 방; 8번과 그만큼의 토큰은 파산 복기용으로 남겨 둠)
#   (incident 중 5번과 그만큼의 토큰은 강제청산 같은 긴급 알림용으로 남겨 둠)
#   scheduled = 아침 08:00, 저녁 22:00, 30일 점검
#   weekly    = 매매법 방 주간 검토
#   total     = 하루 전체 합계. 사고·정기 회의의 남은 몫은 그 회의들을 위해 비워 둠
#   week      = 최근 7일(한국 시간) 전체 합계. 여기서도 사고·정기 회의의 오늘 남은 몫과 앞으로 6일 몫은 비워 둠
# Every call counts against the owners' own Claude plan (shared with their chats). Expected use on a
# busy day is about 45-55 calls and up to 2 million tokens (25-30k tokens per call; the token caps bind
# before the call caps), about 40-50 calls a day over a busy week (10 million tokens). Opus calls use the
# plan faster than sonnet calls, but the caps count both the same.
# Settings that leave a kind of meeting no calls at all (e.g. loss=8, total no bigger than
# incident + scheduled, or week no bigger than 7 x (incident + scheduled)) are allowed but printed
# as a warning at every pass (journalctl -u paperbot-agents).
# On a small plan (e.g. Pro) start lower, e.g. AGENTS_BUDGET=total=50,week=250, and raise it on purpose.
# At a limit a meeting that already started stops with
# '오늘 AI 사용 한도에 도달해 다음으로 미룹니다' and runs the next day; one that cannot start waits.
#AGENTS_BUDGET=incident=15:400000,owner=20:500000,loss=24:700000,scheduled=15:450000,weekly=20:550000,total=80:2000000,week=420:10000000
#
# Approved copy proposals wait for the owners' OK in the dashboard:
#   auto = for the first AGENTS_OWNER_OK_DAYS days of the run, yes = always, no = never
#AGENTS_OWNER_OK=auto
#AGENTS_OWNER_OK_DAYS=60
#
# Copy-proposal slots (proposals waiting for the owners or approved): per strategy and in total
#AGENTS_COPY_CAP_PER_STRATEGY=1
#AGENTS_COPY_CAP_TOTAL=10
#
# Telegram messages the staff may send by themselves per day (the 22:00 summary is not counted)
#AGENTS_FLAG_MAX_PER_DAY=3
#
# Meetings per 15-minute pass, and per room per day (incident meetings are not counted per room;
# one of a room's daily meetings is kept for the owners' posts)
#AGENTS_MAX_ROUNDS_PER_TICK=4
#AGENTS_MAX_ROUNDS_PER_ROOM_DAY=3
#
# AI calls per 15-minute pass: a new meeting starts only if it fits (a strategy meeting counted at 6 calls,
# a team meeting at its number of turns), and retries of unreadable answers stop at this cap (the first
# meeting of a pass and incident meetings are exempt)
#AGENTS_MAX_CALLS_PER_TICK=12
