# /etc/paperbot/live.env  (owner paperbot, chmod 600). Never commit the real file.
# Read-only Binance key: trading and withdrawals disabled, server IP whitelisted.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_CRITICAL=
TELEGRAM_CHAT_WARN=
TELEGRAM_CHAT_INFO=
# Empty WARN/INFO chats fall back to the CRITICAL chat. INFO messages arrive silently.
# External dead-man check URL (e.g. a healthchecks.io check: period 1 min, grace 5 min,
# alerts to both owners' phones). Pinged only while fresh 1m bars are being processed.
DEADMAN_URL=
# Off-site copy of the nightly DB backup (docs/offsite-backup.md): chat id of the private 'paperbot 백업' group.
# Empty: the backup goes to the CRITICAL chat with a note.
TELEGRAM_CHAT_BACKUP=
# Optional: encrypt the off-site copy (openssl aes-256-cbc, pbkdf2). Letters, digits and '-' only, 20+ characters.
# Keep a copy OFF the server: a lost passphrase means the backup can never be restored. Empty: no encryption.
BACKUP_PASSPHRASE=
# Telegram entry / exit alerts (paperbot-tgtrades, paperbot/tradealerts.py): one SILENT message per minute with
# that minute's entries and exits. strategy (default: strategy, copy, new-lab accounts) | all (+ coin flips) | off
#TRADE_ALERTS=strategy
#TRADE_ALERTS_EVERY=60
# exits smaller than this many dollars are counted but not listed
#TRADE_ALERTS_MIN_USD=0
