# 믹스 30분 봇 아침 점검 (paperbot/mixcheck.py morning, docs/mixchop-ko.md 8장): every morning about the previous KST day
# (00:00 -> 24:00 KST) of the '믹스 30분 봇' (paperbot-mixchop, WOO X Pro 2, real money) with its paper twin next to it:
# its 30m signals, entries and skipped signals by reason, live against paper, the entry fills and fees, whether a stop
# rested the whole time, the exchange read failures, the equity and the floor, the day's loss cards, the luck band
# against the 5-year replay (research/mixchop5y/summary.json) and the signal replay (mixchop.evaluate on Binance's
# closed bars against the bot's log). ONE Telegram message to the live bot's own chats, quiet (INFO), WARN when
# something is wrong. Read-only towards the bot: its config, state file and log are read as files (group paperbot),
# never written; no exchange account, no key, no order. Network: Binance's public klines and Telegram only. Writes only
# /var/lib/paperbot/mixcheck (state.json, last-morning.json: the 믹스 성적 screen shows it). Started by
# paperbot-mixcheck.timer; installed and switched on by install.sh, which never starts or touches paperbot-mixchop.
# By hand (prints, sends nothing, writes nothing):
#   cd /opt/crypto-bot-research && sudo -u paperbot /opt/paperbot/venv/bin/python -m paperbot.mixcheck morning --dry-run
[Unit]
Description=paperbot 믹스 30분 봇 아침 점검 (read-only, no orders)
After=network-online.target
Wants=network-online.target
# a failed run sends one Korean Telegram warning a day (deploy/paperbot-failed@.service)
OnFailure=paperbot-failed@%n.service

[Service]
Type=oneshot
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
# the live bot's token and the owners' private chats (as paperbot-mixchop.service); systemd reads the file before the
# sandbox below applies, the code never opens it
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.mixcheck morning
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=800M
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/paperbot/mixcheck
ReadOnlyPaths=-/var/lib/paperbot/exec -/var/lib/paperbot/mixchop-paper /opt/crypto-bot-research
InaccessiblePaths=-/etc/paperbot/executor-wooxpro2.env -/etc/paperbot/executor-toobit.env -/etc/paperbot/executor-gate.env -/etc/paperbot/executor.env -/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/debate.env -/etc/paperbot/live.env -/etc/paperbot/live-telegram.env -/var/lib/paperbot/debate -/var/lib/paperbot/.claude -/var/lib/paperbot/.claude.json -/var/lib/paperbot/.local -/var/backups/paperbot
