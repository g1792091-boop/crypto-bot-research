# 실거래 일일 점검 (paperbot/livecheck.py, docs/live1019-start-ko.md "실거래 일일 점검과 알람"): every morning the trading
# day 09:00 -> 09:00 KST that just ended. The combined paper bot is replayed over the day (paperbot/livereplay.py: the
# bars it stepped on, its own 09:00 snapshot, the market data it reads from Binance) and compared with what it
# recorded; the real executors' trades are matched to their paper trades (price difference in bps, fees, funding);
# the scoreboard (paper, both executors, signal lights, the 40-trade checkpoint). ONE Telegram message, silent when
# everything is fine, loud when the replay disagrees without a known cause, a cost flag fires or an executor is halted.
# Read-only towards the bots: the paper and executor databases are opened read-only (mode=ro), the executors' configs
# are read as plain JSON, executor.env is never opened, no exchange account is called, no order is sent. Public
# Binance klines (paced, 1m/5m cached between nights); the read-only key of live.env only for the leverage brackets,
# as the paper bot. Writes only /var/lib/paperbot/livecheck.db and /var/lib/paperbot/livecheck-cache.db.
# Started by paperbot-livecheck.timer. By hand (prints, sends nothing, writes nothing):
#   cd /opt/crypto-bot-research && sudo -u paperbot /opt/paperbot/venv/bin/python -m paperbot.livecheck run --day 2026-10-19 --dry-run
[Unit]
Description=paperbot live daily check (실거래 일일 점검; read-only, no orders)
After=network-online.target paperbot-combo.service
Wants=network-online.target
# a failed run sends one Korean Telegram warning a day (deploy/paperbot-failed@.service)
OnFailure=paperbot-failed@%n.service

[Service]
Type=oneshot
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/live.env
# the live bot's token and the owners' private chats (optional, deploy/live-telegram.env.example)
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.livecheck run
# Below the live bots: low CPU and disk priority, bounded memory and time (the replay takes about 6 minutes a day on
# the development box and stops itself after --replay-budget-min, 25 minutes; the first night also fills the bar cache).
Nice=15
CPUWeight=10
IOSchedulingClass=idle
MemoryMax=1500M
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# its two files only (SQLite read-only opens of a WAL database also use the folder for the -shm file)
ReadWritePaths=/var/lib/paperbot
ReadOnlyPaths=-/var/lib/paperbot/paper3.db -/var/lib/paperbot/combo/live-ac.db -/var/lib/paperbot/combo/vwap.db -/var/lib/paperbot/daily3.db -/var/lib/paperbot/agents3.db -/var/lib/paperbot/inbox.db -/var/lib/paperbot/checkpoint.db -/var/lib/paperbot/lab /opt/crypto-bot-research
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env -/etc/paperbot/debate.env -/var/lib/paperbot/debate -/var/lib/paperbot/.claude -/var/lib/paperbot/.claude.json -/var/lib/paperbot/.local -/var/backups/paperbot
