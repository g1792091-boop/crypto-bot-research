# Paper v3: 156 accounts (15m/30m/1h/4h; 5m removed 2026-10-04) on live Binance data (docs/server-setup-v3.md).
# Restart is safe: account states are restored from the store and missed minutes are replayed.
[Unit]
Description=paperbot v3 live paper trading
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=paperbot
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/live.env
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.live3 run --db /var/lib/paperbot/paper3.db --procs 4
Restart=always
RestartSec=15
# The runner sends WATCHDOG=1 every poll; if the loop hangs for 10 minutes systemd restarts it.
# Data outages are reported by the external dead-man check (DEADMAN_URL), not by restarts.
NotifyAccess=main
WatchdogSec=600
TimeoutStopSec=60
# SIGTERM to the main process only (it finishes its poll, sends the pending digest and closes the signal workers);
# whatever is left after it exits gets SIGKILL. Signalling the workers too could leave the pool hung on stop.
KillMode=mixed
Nice=5

[Install]
WantedBy=multi-user.target
