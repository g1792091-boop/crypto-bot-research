# Order executor: mirrors ONE paper account into orders on Binance futures (docs/live-safety.md).
# TESTNET by default. Mainnet only with mode "mainnet" in /etc/paperbot/executor.json AND
# PAPERBOT_LIVE_MAINNET=I_UNDERSTAND and LIVE_API_KEY/LIVE_API_SECRET in /etc/paperbot/executor.env AND
# every start-up gate (key cannot withdraw, futures on, IP restricted, wallet <= budget x 1.2).
#
# install.sh installs this unit but NEVER enables or starts it. A person starts it:
#   sudo systemctl start paperbot-executor        (and `enable` only once the testnet soak is done)
#
# Its own user: the executor runs as paperbot-exec (deploy/install.sh makes it; primary group paperbot), NEVER as
# paperbot, the user of the agent rooms, the dashboard and every other service. A process can read the environment
# of another process of its own user (/proc/<pid>/environ: the order keys systemd passes in), trace it or signal it;
# a process of another user cannot, at any moment of its life (no start-up window: the executor's own
# PR_SET_DUMPABLE=0 comes only after its imports and is defence in depth only).
# The key file is root-only (root:root 600): systemd reads EnvironmentFile= as root before it drops to
# paperbot-exec. Group paperbot lets the executor read the code, paper3.db, executor.json and live.env (the paper
# runner's read-only key, which it refuses as an order key). It writes only /var/lib/paperbot/exec
# (paperbot-exec:paperbot 750; UMask 0027: files 640, so the nightly backup, as paperbot, can read them and nothing
# running as paperbot can change them). The agents and the dashboard cannot see /var/lib/paperbot/exec or the key
# file at all (their units hide them).
# Exit status 2 = a gate refused the start for a definite reason (key permissions, wallet, config) with no position
# open: not restarted (fix the cause, then start it by hand). With a position open a mainnet gate found wrong does
# not exit: the executor halts like the kill switch (closes everything, opens nothing) until a person clears it. Any
# other failure (api.binance.com unreachable or not letting the permission check through, a database it cannot open,
# a crash) restarts after 30 s with a CRITICAL alert: open positions keep their exchange stop meanwhile, and the
# executor resumes from its database (a halt stays a halt).
# `systemctl stop` (SIGTERM) lets the loop in progress finish (a stop being placed goes on) before it exits.
[Unit]
Description=paperbot order executor (testnet unless every mainnet gate passes)
After=network-online.target paperbot-live3.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=paperbot-exec
Group=paperbot
UMask=0027
WorkingDirectory=/opt/crypto-bot-research
EnvironmentFile=/etc/paperbot/executor.env
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.executor run --config /etc/paperbot/executor.json
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/paperbot/exec
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env
# no core dump (it would hold the keys)
LimitCORE=0

[Install]
WantedBy=multi-user.target
