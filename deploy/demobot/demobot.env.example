# /etc/demobot/demobot.env  (root:demobot 640) — 데모 랩 봇 설정 / demo lab bot settings.
# 서버에서만, 편집기 안에서만 채웁니다:  SUDO_EDITOR=nano sudoedit /etc/demobot/demobot.env
# 진짜 값은 채팅·메일·저장소에 절대 넣지 않습니다. 이 예시 파일에는 값이 없습니다.
# Fill on the server only, inside the editor. Never paste real values into a chat or commit them.
# The install script copies this file to /etc/demobot/demobot.env only when that file does not exist yet.

# ---- 텔레그램 / Telegram (새 봇; 규칙봇의 봇이 아님 / a NEW bot, never the rule bot's)
# BotFather가 준 토큰 / the token BotFather gave
DEMOBOT_TG_TOKEN=
# 받을 번호, 쉼표로 이어 최대 4개: 두 분 각자의 개인 대화 번호(봇에서 시작을 누른 뒤), 또는 단체방 번호(-100...).
# 예: DEMOBOT_TG_CHAT=123456789,987654321   찾기 / find them:
#   cd /opt/demobot/app && sudo -u demobot /opt/demobot/venv/bin/python -m demobot.notify chatid
# 1-4 chat ids, comma separated (the owners' private chats with the bot, and/or a group); only these are read
DEMOBOT_TG_CHAT=

# ---- 대시보드 / dashboard
# 비밀번호 해시 (12자 이상 비밀번호). 만들기 / make it:
#   cd /opt/demobot/app && /opt/demobot/venv/bin/python -B -m demobot.dash hash
# 해시에 $ 기호가 있으니 작은따옴표로 감쌉니다 / wrap it in single quotes: DEMOBOT_DASH_PASSWORD_HASH='pbkdf2$...'
DEMOBOT_DASH_PASSWORD_HASH=
# 32자 이상 임의 문자열 / 32+ random characters:  openssl rand -hex 32
DEMOBOT_DASH_SECRET=
# 서버의 Tailscale 주소 (tailscale ip -4 → 100.x.y.z), 또는 SSH 터널이면 127.0.0.1
# the server's Tailscale address, or 127.0.0.1 with an SSH tunnel. Never 0.0.0.0.
DEMOBOT_DASH_HOST=127.0.0.1
# 규칙봇 대시보드는 8080, 데모 랩은 8090 / the rule bot uses 8080
DEMOBOT_DASH_PORT=8090

# ---- 선택: 서버 밖 감시·밤 백업 (비워 두면 꺼짐) / optional: outside watch, nightly backup (empty = off)
# healthchecks.io에서 새로 만든 체크(예: demolab, 주기 15분, 유예 30분)의 Ping URL (https://hc-ping.com/...).
# 엔진이 15분마다 계산을 마칠 때 이 주소를 부릅니다. 서버가 멈추면 healthchecks.io가 메일로 알려 줍니다.
# the Ping URL of a NEW healthchecks.io check; the engine calls it after every tick (dead-man switch)
DEMOBOT_DEADMAN_URL=
# 밤 백업 파일을 받을 번호 (쉼표로 여럿 가능). 비우면 위의 DEMOBOT_TG_CHAT의 모든 번호로 갑니다.
# chat(s) that receive the nightly backup file, comma separated; empty = every chat of DEMOBOT_TG_CHAT
DEMOBOT_BACKUP_CHAT=
# 밤 백업 암호 (선택). 넣으면 파일을 openssl AES-256으로 잠급니다. 영문·숫자만:  openssl rand -hex 24
# 서버 밖 안전한 곳(두 분의 비밀번호 관리 앱)에 먼저 적어 둡니다. 잃으면 백업을 열 수 없습니다.
# optional backup passphrase (letters and digits); keep a copy OFF the server, or the backups cannot be opened
DEMOBOT_BACKUP_PASSPHRASE=

# ---- 저장 위치 (보통 그대로 둡니다) / storage (leave as is)
# 비공개 매매법 파일 폴더 (기본값; 바꿀 일 없음) / private strategy plug-ins folder (default)
#DEMOBOT_PLUGINS=/etc/demobot/plugins
DEMOBOT_DB=/var/lib/demobot/demo.db
DEMOBOT_SNAP=/var/lib/demobot/snap
