# Demo lab bot ("데모 랩") outside watch: one check of `python -m demobot.watch`, started by demobot-watch.timer
# (every 10 minutes). Reads snap/status.json, rank_meta.json, backup.json and the systemd state of demobot-live and
# demobot-rank (unprivileged reads), and warns in the demo lab's Telegram group itself (not through the engine's
# outbox): engine stopped or no tick for 45 minutes, no ranking for 3 hours or a failed ranking run, no good backup
# for 36 hours; at most one warning per kind every 3 hours, and one message when it recovers. Writes snap/watch.json
# and /var/lib/demobot/watch_state.json. If the whole server is down this cannot run: that is what the dead-man check
# (DEMOBOT_DEADMAN_URL, healthchecks.io) is for. Same user, sandbox and env file as the engine.
[Unit]
Description=demobot demo lab outside watch (one check)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=demobot
Group=demobot
UMask=0027
WorkingDirectory=/opt/demobot/app
EnvironmentFile=/etc/demobot/demobot.env
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# the watch never needs the dashboard's login values
UnsetEnvironment=DEMOBOT_DASH_PASSWORD_HASH DEMOBOT_DASH_SECRET
ExecStart=/opt/demobot/venv/bin/python -m demobot.watch
TimeoutStartSec=3min
KillMode=mixed
# A guest on the rule bot's server: a few seconds every 10 minutes, low priority, small memory cap.
Nice=10
CPUQuota=20%
MemoryHigh=120M
MemoryMax=150M
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Sandbox: read-only system, writes only its own folder.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/demobot
InaccessiblePaths=-/etc/paperbot -/var/lib/paperbot -/var/backups/paperbot
