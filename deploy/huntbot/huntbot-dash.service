# 추세 사냥 모의 봇 dashboard: read-only views of /var/lib/huntbot/snap behind a password (port 8092 by default), on
# this server's Tailscale address only.
[Unit]
Description=huntbot dashboard (read-only)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=huntbot
Group=huntbot
UMask=0027
WorkingDirectory=/opt/huntbot/app
EnvironmentFile=/etc/huntbot/huntbot.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=HUNTBOT_SNAP=/var/lib/huntbot/snap
UnsetEnvironment=HUNTBOT_TG_TOKEN HUNTBOT_TG_CHAT
ExecStartPre=/bin/sh -c 'if [ -z "$$HUNTBOT_DASH_HOST" ]; then echo "HUNTBOT_DASH_HOST empty in /etc/huntbot/huntbot.env" >&2; exit 1; fi'
ExecStartPre=-/bin/sh -c 'n=0; until ip -4 -o addr show | grep -qF " inet $$HUNTBOT_DASH_HOST/" || [ $$n -ge 60 ]; do n=$$((n+1)); sleep 1; done'
ExecStart=/opt/huntbot/venv/bin/python -m huntbot dash
Restart=always
RestartSec=10
Nice=10
MemoryMax=400M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/lib/huntbot
InaccessiblePaths=-/var/lib/huntbot/private

[Install]
WantedBy=multi-user.target
