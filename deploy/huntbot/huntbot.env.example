# /etc/huntbot/huntbot.env  (root:huntbot 640) — 추세 사냥 모의 봇 설정 / trend-hunt paper bot settings.
# 서버에서만 채웁니다: sudo bash /root/huntbot-src/deploy/huntbot/setup_env.sh   (또는 SUDO_EDITOR=nano sudoedit 이 파일)
# 진짜 값은 채팅·메일·저장소에 절대 넣지 않습니다. 이 예시 파일에는 값이 없습니다. 거래소 키는 없습니다 (주문 없음).

# ---- 텔레그램 / Telegram (규칙봇·후보 리그와 같은 봇을 써도 됩니다: 메시지 첫 줄에 '추세 사냥'이 붙습니다)
HUNTBOT_TG_TOKEN=
# 받을 번호, 쉼표로 이어 최대 4개 / 1-4 chat ids, comma separated
HUNTBOT_TG_CHAT=

# ---- 대시보드 / dashboard (setup_env.sh가 채웁니다)
HUNTBOT_DASH_PASSWORD_HASH=
HUNTBOT_DASH_SECRET=
# 이 서버의 Tailscale 주소 (100.x.x.x) / this server's Tailscale address
HUNTBOT_DASH_HOST=
HUNTBOT_DASH_PORT=8092
# 1 = 비밀번호 없이 (Tailscale 주소에서만) / no password (Tailscale address only)
HUNTBOT_DASH_OPEN=0

# ---- 엔진 / engine (보통 그대로 / normally leave as is)
HUNTBOT_DATA=/var/lib/huntbot
# 지표용 과거 자료 시작일 (10/01보다 400일 이상 앞) / history start, >= 400 days before 2026-10-01
HUNTBOT_WARMUP_START=2025-01-01
# 계산 프로세스 수, 0 = CPU 전부 / worker processes, 0 = all CPUs
HUNTBOT_PROCS=0
# 코인 목록 파일 (비우면 research/hunt/universe30.json, 없으면 사전 등록 3장의 30개) / universe file
HUNTBOT_UNIVERSE=
# 라인업 파일 (비우면 /var/lib/huntbot/lineup.json이 있으면 그것, 없으면 코드의 huntbot/lineup.json) / lineup file
HUNTBOT_LINEUP=
