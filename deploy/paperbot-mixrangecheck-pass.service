# 레인지 봇 손실 카드 (paperbot/mixcheck.py pass with PAPERBOT_MIX_BOT=range, docs/range-bot-ko.md 0장; owners 10-31
# night): every 5 minutes, each closed live trade of the '레인지 봇' once, a few minutes after its close: a losing one gets
# a loss card (the plan: margin 40 % of the balance, the stop's loss of that entry plus WOO X Pro's taker fee on both
# sides; normal stop-out as designed, or abnormal with the causes the bot's log and the numbers show; the paper twin's
# result on the same signal), a winning one a short line. Read-only towards the bot; writes only
# /var/lib/paperbot/mixrangecheck/state.json. By hand (prints what would be sent; sends nothing, writes nothing):
#   cd /opt/crypto-bot-research && sudo -u paperbot env PAPERBOT_MIX_BOT=range /opt/paperbot/venv/bin/python -m paperbot.mixcheck pass --dry-run
[Unit]
Description=paperbot 레인지 봇 손실 카드 every 5 minutes (read-only, no orders)
After=network-online.target
Wants=network-online.target
OnFailure=paperbot-failed@%n.service

[Service]
Type=oneshot
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
# the live bot's token and the owners' private chats (as paperbot-mixrange.service); systemd reads the file before the
# sandbox below applies, the code never opens it
EnvironmentFile=-/etc/paperbot/live-telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
# which mix bot (paperbot/dash/more/livemix.py PROFILES): its config, files, words and this folder
Environment=PAPERBOT_MIX_BOT=range
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.mixcheck pass
Nice=5
MemoryMax=400M
TimeoutStartSec=3min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/paperbot/mixrangecheck
ReadOnlyPaths=-/var/lib/paperbot/exec -/var/lib/paperbot/mixrange-paper /opt/crypto-bot-research
InaccessiblePaths=-/etc/paperbot/executor-wooxpro2.env -/etc/paperbot/executor-toobit.env -/etc/paperbot/executor-gate.env -/etc/paperbot/executor.env -/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/debate.env -/etc/paperbot/live.env -/etc/paperbot/live-telegram.env -/var/lib/paperbot/debate -/var/lib/paperbot/.claude -/var/lib/paperbot/.claude.json -/var/lib/paperbot/.local -/var/backups/paperbot
