# Off-site copy of the nightly database backup to a private Telegram group (paperbot/offsite.py,
# docs/offsite-backup.md). The server has no Vultr automatic backups, so the copies that
# paperbot-backup.service writes to /var/backups/paperbot/<date>/ would be lost with the server.
# Started by paperbot-offsite.timer 35 minutes after the backup: takes that folder (refuses it when a
# copy is missing or still being written), packs it (tar + zstd, gzip without zstd), encrypts it with
# the openssl program only when BACKUP_PASSPHRASE is set, splits it into 45 MB parts (Telegram's limit is
# 50 MB) and uploads them with a manifest and a short Korean summary to TELEGRAM_CHAT_BACKUP (empty: the
# CRITICAL chat, with a note). Any failure sends a Korean WARN through the usual alert chat and fails the
# unit (systemctl --failed). The server's own copies are not touched.
# Reads the backup folder and checks which live databases exist; opens none of them and writes nothing
# outside its private /tmp: it is not a writer of any database.
[Unit]
Description=paperbot off-site backup copy to Telegram
After=network-online.target paperbot-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_BACKUP (and the CRITICAL/WARN chats for the failure alert), optional
# BACKUP_PASSPHRASE. systemd reads the file before the sandbox below applies; the job itself cannot open it.
EnvironmentFile=/etc/paperbot/live.env
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.offsite send --from /var/backups/paperbot --chat-env TELEGRAM_CHAT_BACKUP --lib /var/lib/paperbot
# The live runner comes first: compression gets little CPU and disk time.
Nice=15
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=30min
# The archive is built in a private /tmp (removed when the job ends); everything else is read-only.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# '-': a missing folder is reported by the job itself (Korean WARN), not as a sandbox set-up failure
ReadOnlyPaths=-/var/backups/paperbot -/var/lib/paperbot
InaccessiblePaths=-/etc/paperbot/live.env -/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env
