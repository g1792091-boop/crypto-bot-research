# 실거래 실시간 감시 (paperbot/livecheck.py watch, docs/live1019-start-ko.md section 12): every minute (one pass takes
# about half a second). The live Telegram stream: each paper entry, first lock and exit with what each executor did
# (🟢 / 🔒 / ✅, ❌ = the loss card), a signal light that changes (🚦), the 40th paper trade (🏁), an executor started or
# stopped by hand (▶️ / ⏹); and one LOUD message per new problem, re-armed once it clears (de-duplicated in
# /var/lib/paperbot/livecheck.db): an executor that did not follow a paper entry its light allowed, an open position
# without a recorded stop, an executor or the paper bot or the rule bot's bars gone quiet, equity 25% below its peak,
# the paper below its backtest range, a halt summary, low disk or memory on this shared server. Where they go and what
# rings: /etc/paperbot/live-telegram.env (the owners' private chats, TELEGRAM_SOUND=critical), loaded after live.env.
# Read-only towards the bots: their databases opened read-only, the executors' configs read as JSON, executor.env never
# opened, no exchange call, no order, no Binance call; `systemctl is-active / is-enabled / show` only reads.
# Writes only /var/lib/paperbot/livecheck.db. Started by paperbot-livewatch.timer.
# By hand (prints what would be sent; sends nothing, writes nothing):
#   cd /opt/crypto-bot-research && sudo -u paperbot /opt/paperbot/venv/bin/python -m paperbot.livecheck watch --dry-run
# Every message type with sample numbers: ... -m paperbot.livecheck preview
[Unit]
Description=paperbot live watcher every minute (실거래 실시간 감시; read-only, no orders)
After=network-online.target
# a failed run sends one Korean Telegram warning a day (deploy/paperbot-failed@.service)
OnFailure=paperbot-failed@%n.service

[Service]
Type=oneshot
User=paperbot
Group=paperbot
WorkingDirectory=/opt/crypto-bot-research
# TELEGRAM_BOT_TOKEN and the chats; systemd reads the file before the sandbox below applies
EnvironmentFile=/etc/paperbot/live.env
# the owners' private chats for the live messages (optional, deploy/live-telegram.env.example)
EnvironmentFile=-/etc/paperbot/live-telegram.env
# the exchange key and the dead-man URL are not this job's business
UnsetEnvironment=BINANCE_API_KEY BINANCE_API_SECRET DEADMAN_URL BACKUP_PASSPHRASE
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/paperbot/venv/bin/python -m paperbot.livecheck watch
Nice=5
MemoryMax=300M
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# its one file (SQLite read-only opens of a WAL database also use the folder for the -shm file)
ReadWritePaths=/var/lib/paperbot
ReadOnlyPaths=-/var/lib/paperbot/paper3.db -/var/lib/paperbot/combo/live-ac.db -/var/lib/paperbot/daily3.db -/var/lib/paperbot/agents3.db -/var/lib/paperbot/inbox.db -/var/lib/paperbot/checkpoint.db -/var/lib/paperbot/lab /opt/crypto-bot-research
InaccessiblePaths=-/etc/paperbot/agents.env -/etc/paperbot/dash.env -/etc/paperbot/executor.env -/etc/paperbot/debate.env -/var/lib/paperbot/debate -/var/lib/paperbot/.claude -/var/lib/paperbot/.claude.json -/var/lib/paperbot/.local -/var/backups/paperbot
