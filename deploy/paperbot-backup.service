# Consistent copies of the paperbot databases, 14 days kept (deploy/paperbot-backup.sh). agents3.db
# holds the agents' hypothesis ledger (the gate's test count) and inbox.db the owners' posts and
# approvals; they are copied first. Each copy is `VACUUM INTO` on a read-only connection: one read
# transaction, so the live runner's commits every few seconds cannot restart it (the old `.backup`
# restarted on every commit and never finished on a large paper3.db). The backup is not a writer of
# any database. A copy that fails makes the unit fail (exit status), after the old copies are pruned;
# a copy that hangs is stopped after 30 minutes (the unit fails then too).
# A failed backup sends the owners' one Korean warning (paperbot-failed@, owners' G31): before, only the next
# morning's off-site check or launchcheck noticed it.
[Unit]
Description=paperbot database backup
OnFailure=paperbot-failed@%n.service

[Service]
Type=oneshot
User=paperbot
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
ExecStart=/bin/sh /opt/crypto-bot-research/deploy/paperbot-backup.sh
