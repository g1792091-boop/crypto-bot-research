# /etc/paperbot/executor.env  (root:root, chmod 600; systemd reads it for paperbot-executor.service and passes it
# to the executor's own user paperbot-exec only, never to a paperbot process: docs/live-safety.md 1-9).
# Never commit the real file. Only the variables of the mode in /etc/paperbot/executor.json are used.
#
# Testnet (fake money): a key made on https://testnet.binancefuture.com
TESTNET_API_KEY=
TESTNET_API_SECRET=
# Mainnet (real money): a key of the executor's SUB-ACCOUNT, futures trading on, withdrawals OFF,
# restricted to this server's IP. Never the paper runner's read-only key (BINANCE_API_KEY).
LIVE_API_KEY=
LIVE_API_SECRET=
# Bybit ("exchange": "bybit" in executor.json; docs/bybit-ko.md). Testnet: a key made on https://testnet.bybit.com.
# Mainnet: a key of the executor's SUB-ACCOUNT, Contract Orders+Positions only, no withdrawal/transfer, this server's IP.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=
# MEXC ("exchange": "mexc" in executor-mexc.json; docs/mexc-ko.md). Mainnet only (MEXC has no futures testnet): a key
# of the KYC-verified account used only by the executor, futures trading only, NO withdrawal, bound to this server's IP.
MEXC_LIVE_KEY=
MEXC_LIVE_SECRET=
# MEXC cannot report a key's permissions through the API: after checking the key in the MEXC app, write exactly
# FUTURES_ONLY_NO_WITHDRAW_IP_BOUND here (the executor refuses to start without it).
MEXC_LIVE_KEY_CHECKED=
# The mainnet switch: exactly I_UNDERSTAND, and only together with "mode": "mainnet" in executor.json.
PAPERBOT_LIVE_MAINNET=
# Alerts: the live-trading bot (its own token from @BotFather, not live.env's rule bot) and the owners' private
# chat ids (comma-separated). /etc/paperbot/live-telegram.env, loaded after this file, sets them for every live unit
# and wins; keeping both the same is fine (docs/live1019-start-ko.md section 12).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_CRITICAL=
TELEGRAM_CHAT_WARN=
TELEGRAM_CHAT_INFO=
